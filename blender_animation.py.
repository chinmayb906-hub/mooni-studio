
import bpy
import json
import os
import math
import random

ROOT = os.getcwd()
EPISODE_FILE = os.path.join(ROOT, "output", "episode.json")
OUT_DIR = os.path.join(ROOT, "output", "3dclips")

WIDTH = 720
HEIGHT = 1280
FPS = 24
DURATION = 5
FRAMES = FPS * DURATION

os.makedirs(OUT_DIR, exist_ok=True)

with open(EPISODE_FILE, encoding="utf-8") as f:
    episode = json.load(f)

# Reset scene
bpy.ops.object.select_all(action="SELECT")
bpy.ops.object.delete(use_global=False)

def material(name, color):
    mat = bpy.data.materials.new(name)
    mat.diffuse_color = (*color, 1)
    return mat

BLUE = material("Golu Blue", (0.08, 0.25, 0.8))
YELLOW = material("Tara Yellow", (1.0, 0.75, 0.05))
WHITE = material("Moti White", (0.95, 0.95, 0.95))
BROWN = material("Brown", (0.35, 0.16, 0.06))
GREEN = material("Grass Green", (0.18, 0.48, 0.12))
SKIN = material("Warm Skin", (0.75, 0.45, 0.27))
RED = material("Red", (0.85, 0.1, 0.12))
ORANGE = material("Fox Orange", (0.9, 0.32, 0.08))
PURPLE = material("Purple", (0.45, 0.2, 0.75))
CYAN = material("Cyan", (0.1, 0.65, 0.8))
DARK = material("Dark", (0.06, 0.06, 0.08))
GOLD = material("Gold", (1.0, 0.65, 0.1))

def assign(obj, mat):
    obj.data.materials.append(mat)
    return obj

def sphere(name, location, scale, mat):
    bpy.ops.mesh.primitive_uv_sphere_add(
        segments=16,
        ring_count=12,
        location=location
    )
    obj = bpy.context.object
    obj.name = name
    obj.scale = scale
    assign(obj, mat)
    return obj

def cube(name, location, scale, mat):
    bpy.ops.mesh.primitive_cube_add(location=location)
    obj = bpy.context.object
    obj.name = name
    obj.scale = scale
    assign(obj, mat)
    return obj

def cone(name, location, radius, depth, mat):
    bpy.ops.mesh.primitive_cone_add(
        vertices=16,
        radius1=radius,
        radius2=0,
        depth=depth,
        location=location
    )
    obj = bpy.context.object
    obj.name = name
    assign(obj, mat)
    return obj

def create_character(name, x, mat, kind="person"):
    parts = []

    if kind == "dog":
        body = sphere(name + "_body", (x, 0, 0.55), (0.55, 0.3, 0.3), mat)
        head = sphere(name + "_head", (x + 0.4, 0, 0.85), (0.3, 0.3, 0.3), mat)
        ears = [
            cone(name + "_ear1", (x + 0.25, 0, 1.12), 0.12, 0.35, mat),
            cone(name + "_ear2", (x + 0.5, 0, 1.12), 0.12, 0.35, mat)
        ]
        legs = [
            cube(name + "_leg1", (x - 0.25, -0.15, 0.2), (0.08, 0.08, 0.22), mat),
            cube(name + "_leg2", (x - 0.25, 0.15, 0.2), (0.08, 0.08, 0.22), mat),
            cube(name + "_leg3", (x + 0.25, -0.15, 0.2), (0.08, 0.08, 0.22), mat),
            cube(name + "_leg4", (x + 0.25, 0.15, 0.2), (0.08, 0.08, 0.22), mat)
        ]
        parts = [body, head] + ears + legs

    elif kind == "bird":
        body = sphere(name + "_body", (x, 0, 0.9), (0.32, 0.28, 0.42), mat)
        head = sphere(name + "_head", (x, 0, 1.3), (0.25, 0.25, 0.25), mat)
        beak = cone(name + "_beak", (x + 0.28, 0, 1.28), 0.13, 0.25, GOLD)
        wing1 = sphere(name + "_wing1", (x - 0.22, 0, 0.95), (0.16, 0.15, 0.28), GOLD)
        wing2 = sphere(name + "_wing2", (x + 0.22, 0, 0.95), (0.16, 0.15, 0.28), GOLD)
        parts = [body, head, beak, wing1, wing2]

    else:
        body = cube(name + "_body", (x, 0, 1.05), (0.35, 0.25, 0.48), mat)
        head = sphere(name + "_head", (x, 0, 1.85), (0.42, 0.36, 0.42), SKIN)
        legs = [
            cube(name + "_leg1", (x - 0.18, 0, 0.38), (0.1, 0.12, 0.38), DARK),
            cube(name + "_leg2", (x + 0.18, 0, 0.38), (0.1, 0.12, 0.38), DARK)
        ]
        arms = [
            sphere(name + "_arm1", (x - 0.45, 0, 1.12), (0.12, 0.12, 0.4), mat),
            sphere(name + "_arm2", (x + 0.45, 0, 1.12), (0.12, 0.12, 0.4), mat)
        ]
        eyes = [
            sphere(name + "_eye1", (x - 0.14, -0.32, 1.9), (0.07, 0.06, 0.08), DARK),
            sphere(name + "_eye2", (x + 0.14, -0.32, 1.9), (0.07, 0.06, 0.08), DARK)
        ]
        parts = [body, head] + legs + arms + eyes

    # Parent character parts to a single animated root.
    root = bpy.data.objects.new(name + "_ROOT", None)
    bpy.context.collection.objects.link(root)

    for obj in parts:
        obj.parent = root

    # Gentle animated bounce
    root.location.x = 0
    root.location.z = 0

    for frame in range(1, FRAMES + 1, 12):
        root.location.z = 0.12 * math.sin(frame / 8)
        root.keyframe_insert(data_path="location", frame=frame)

    if root.animation_data and root.animation_data.action:
        for curve in root.animation_data.action.fcurves:
            for key in curve.keyframe_points:
                key.interpolation = "SINE"

    return root

def village():
    # Ground
    cube("Ground", (0, 0, -0.15), (20, 20, 0.15), GREEN)

    # Small house
    cube("VillageHouse", (-3, 2, 1), (1.6, 1.5, 1), BROWN)
    cone("Roof", (-3, 2, 2.5), 2.1, 1.3, RED)

    # Trees
    for x in (-5, 5, 6):
        cube("TreeTrunk", (x, 3, 1), (0.2, 0.2, 1), BROWN)
        sphere("TreeLeaves", (x, 3, 2.5), (1, 1, 1.2), GREEN)

    # Decorative rocks
    for i in range(8):
        sphere(
            "Rock",
            (random.uniform(-6, 6), random.uniform(-4, 4), 0),
            (0.2, 0.25, 0.12),
            WHITE
        )

def lighting_camera():
    bpy.ops.object.light_add(type="SUN", location=(0, -4, 8))
    sun = bpy.context.object
    sun.data.energy = 2

    bpy.ops.object.camera_add(location=(0, -12, 6))
    camera = bpy.context.object

    camera.rotation_euler = (
        math.radians(68),
        0,
        0
    )

    camera.rotation_euler[2] = 0

    bpy.context.scene.camera = camera

    camera.data.lens = 35

def setup_render():
    scene = bpy.context.scene

    scene.render.engine = "BLENDER_EEVEE_NEXT"
    scene.render.resolution_x = WIDTH
    scene.render.resolution_y = HEIGHT
    scene.render.resolution_percentage = 100
    scene.render.fps = FPS

    scene.frame_start = 1
    scene.frame_end = FRAMES

    scene.render.image_settings.file_format = "FFMPEG"
    scene.render.image_settings.color_mode = "RGB"

    scene.render.ffmpeg.format = "MPEG4"
    scene.render.ffmpeg.codec = "H264"
    scene.render.ffmpeg.constant_rate_factor = "MEDIUM"

    scene.world.color = (0.12, 0.12, 0.12)

def main():
    setup_render()

    for i, scene_data in enumerate(episode.get("scenes", []), 1):
        bpy.ops.object.select_all(action="SELECT")
        bpy.ops.object.delete(use_global=False)

        village()
        lighting_camera()

        names = scene_data.get("characters", [])
        x_positions = [-2.5, -1.0, 1.0, 2.5]

        for j, name in enumerate(names[:4]):
            name = str(name).lower()

            if name == "golu":
                create_character("Golu", x_positions[j], BLUE)
            elif name == "tara":
                create_character("Tara", x_positions[j], YELLOW)
            elif name == "moti":
                create_character("Moti", x_positions[j], WHITE, "dog")
            elif name == "dadi":
                create_character("Dadi", x_positions[j], PURPLE)
            elif name == "aarav":
                create_character("Aarav", x_positions[j], GREEN)
            elif name == "meera":
                create_character("Meera", x_positions[j], CYAN)
            elif name == "chiku":
                create_character("Chiku", x_positions[j], ORANGE, "dog")
            elif name == "bholu":
                create_character("Bholu", x_positions[j], GREEN, "bird")
            elif name == "uncle bhola":
                create_character("UncleBhola", x_positions[j], BLUE)

        scene = bpy.context.scene
        scene.frame_set(1)

        scene.render.filepath = os.path.join(
            OUT_DIR,
            f"scene_{i:02d}.mp4"
        )

        bpy.ops.render.render(animation=True)

        print("Rendered 3D scene:", i)

if __name__ == "__main__":
    main()
